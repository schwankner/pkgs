diff --git a/drivers/gpu/host1x-fence/dev.c b/drivers/gpu/host1x-fence/dev.c
index 2229978..4385b9a 100644
--- a/drivers/gpu/host1x-fence/dev.c
+++ b/drivers/gpu/host1x-fence/dev.c
@@ -15,6 +15,12 @@
 #include <linux/poll.h>
 #include <linux/slab.h>
 #include <linux/sync_file.h>
+#include <linux/version.h>
+
+/* Linux v7.1 can embed the fence lock; dma_fence_spinlock() returns either kind */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 1, 0)
+#define dma_fence_spinlock(fence) ((fence)->lock)
+#endif
 
 #include "include/uapi/linux/host1x-fence.h"
 
@@ -214,8 +220,8 @@ static int host1x_pollfd_release(struct inode *inode, struct file *file)
 			pfd_fence->callback_set = false;
 		}
 		/*The lock/unlock just ensures that the callback execution has finished*/
-		spin_lock(pfd_fence->fence->lock);
-		spin_unlock(pfd_fence->fence->lock);
+		spin_lock(dma_fence_spinlock(pfd_fence->fence));
+		spin_unlock(dma_fence_spinlock(pfd_fence->fence));
 
 		dma_fence_put(pfd_fence->fence);
 		kfree(pfd_fence);
@@ -249,8 +255,8 @@ static unsigned int host1x_pollfd_poll(struct file *file, poll_table *wait)
 				pfd_fence->callback_set = false;
 			}
 			/*The lock/unlock just ensures that the callback execution has finished*/
-			spin_lock(pfd_fence->fence->lock);
-			spin_unlock(pfd_fence->fence->lock);
+			spin_lock(dma_fence_spinlock(pfd_fence->fence));
+			spin_unlock(dma_fence_spinlock(pfd_fence->fence));
 
 			dma_fence_put(pfd_fence->fence);
 			list_del(&pfd_fence->list);
diff --git a/scripts/conftest/conftest.sh b/scripts/conftest/conftest.sh
