 		return -ENOENT;
 	}
 
-	gpio = of_get_named_gpio(np, "nvgpu-therm-gpios", index);
+	gpio = nvgpu_of_get_named_gpio(np, "nvgpu-therm", index);
 	if (gpio < 0) {
 		nvgpu_err(&l->g, "failed to get GPIO %d ", gpio);
 		return gpio;
