diff --git a/drivers/gpu/nvgpu/os/linux/module.c b/drivers/gpu/nvgpu/os/linux/module.c
index ae083a0..497675c 100644
--- a/drivers/gpu/nvgpu/os/linux/module.c
+++ b/drivers/gpu/nvgpu/os/linux/module.c
@@ -26,7 +26,28 @@
 #include <linux/platform/tegra/common.h>
 #endif
 #include <linux/pci.h>
+#include <linux/version.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+#include <linux/gpio.h>
+#include <linux/of.h>
+
+/* of_get_named_gpio() was removed in Linux v7.1: look the GPIO up, return its number */
+static inline int nvgpu_of_get_named_gpio(struct device_node *np, const char *con_id, int index)
+{
+	struct gpio_desc *desc = fwnode_gpiod_get_index(of_fwnode_handle(np), con_id,
+							index, GPIOD_ASIS, NULL);
+	int gpio;
+
+	if (IS_ERR(desc))
+		return PTR_ERR(desc);
+	gpio = desc_to_gpio(desc);
+	gpiod_put(desc);
+	return gpio;
+}
+#else
 #include <linux/of_gpio.h>
+#define nvgpu_of_get_named_gpio(np, con_id, index) of_get_named_gpio(np, con_id "-gpios", index)
+#endif
 
 #include <uapi/linux/nvgpu.h>
 #ifdef CONFIG_NVGPU_TEGRA_FUSE
