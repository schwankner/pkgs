diff --git a/drivers/gpu/nvgpu/include/nvgpu/linux/strncpy.h b/drivers/gpu/nvgpu/include/nvgpu/linux/strncpy.h
new file mode 100644
index 0000000..12da955
--- /dev/null
+++ b/drivers/gpu/nvgpu/include/nvgpu/linux/strncpy.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Linux v7.2 removed strncpy(). nvgpu relies on its exact semantics (copy at
+ * most count bytes, zero-pad the rest, no forced terminator), so provide it.
+ * Force-included for every nvgpu object by the Makefile.
+ */
+#ifndef NVGPU_LINUX_STRNCPY_H
+#define NVGPU_LINUX_STRNCPY_H
+
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+#include <linux/string.h>
+
+static inline char *nvgpu_strncpy(char *dest, const char *src, size_t count)
+{
+	size_t len = strnlen(src, count);
+
+	memcpy(dest, src, len);
+	memset(dest + len, 0, count - len);
+	return dest;
+}
+#define strncpy nvgpu_strncpy
+#endif
+
+#endif
