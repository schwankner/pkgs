+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+/* clk_ops.round_rate was removed in Linux v7.1 */
+static int gm20b_determine_rate_ops(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	struct clk_gk20a *clk = clk_gk20a_from_hw(hw);
+
+	req->rate = gm20b_round_rate(clk, req->rate, &req->best_parent_rate);
+	return 0;
+}
+#else
